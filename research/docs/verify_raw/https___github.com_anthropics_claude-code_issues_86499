AAB6NHLcw","archivedAt":null,"nameHTML":"has repro","name":"has repro","color":"ededed","description":"Has detailed reproduction steps"},"id":"LE_lADON91aY88AAAABMrCBis8AAAAG2bkrRA","intent":null,"__isNode":"LabeledEvent"},"cursor":"Y3Vyc29yOnYyOpPPAAABn_y97AgBqzI5NDIyNTk0ODg0"},{"node":{"__typename":"IssueComment","databaseId":5297995711,"viewerDidAuthor":false,"issue":{"author":{"__typename":"User","login":"YoniChechik","id":"MDQ6VXNlcjE2Njg2OTI0"},"id":"I_kwDON91aY88AAAABMrCBig","number":86499,"locked":false,"databaseId":5145395594},"author":{"__typename":"User","login":"kcarriedo","avatarUrl":"https://avatars.githubusercontent.com/u/323828?u=0e78894fa59b7589cc7fa47b10aad5d7333b8a35\u0026v=4","profileUrl":"https://github.com/kcarriedo","id":"MDQ6VXNlcjMyMzgyOA==","name":"Kyle Carriedo"},"id":"IC_kwDON91aY88AAAABO8j_vw","url":"https://github.com/anthropics/claude-code/issues/86499#issuecomment-5297995711","createdAt":"2026-08-14T20:44:08Z","authorAssociation":"NONE","viewerCanDelete":false,"viewerCanMinimize":false,"viewerCanUnminimize":false,"viewerCanReport":false,"viewerCanReportToMaintainer":false,"viewerCanBlockFromOrg":false,"viewerCanUnblockFromOrg":false,"viewerCanBlockPersonally":false,"viewerCanUnblockPersonally":false,"viewerCanPin":false,"viewerCanUnpin":false,"viaApp":null,"minimizedReason":null,"showSpammyBadge":false,"createdViaEmail":false,"authorToRepoOwnerSponsorship":null,"viewerCanReadUserContentEdits":true,"lastEditedAt":null,"lastUserContentEdit":null,"pinnedBy":null,"body":"This is a very clean reproduction - the debug trace makes it clear this is a connection-pool or stream-multiplexing issue specific to concurrent SSE streams, not a general network problem. The fact that main-thread heartbeats stayed healthy while subagent streams went silent is the key signal.\n\nA few observations that might help narrow it down:\n\n**The 60s vs 180s watchdog split is interesting.** Your trace shows `idleDeadlineMs=180000` in the WARN lines but the watchdog fires at 60000ms. That suggests there are two separate timers - one for the stream itself and one specifically for the `AsyncAgent` wrapper - and the agent-level one is the tighter gate. Worth checking if increasing the agent watchdog timeout (if configurable) changes behavior, or if the streams are genuinely dying at the server side.\n\n**The \"exactly one chunk then silence\" pattern** (647 bytes after 1.1s, then nothing for 60s) is distinct from slow streams. It looks like the connection is accepted and headers/initial data arrive, then the upstream closes or drops the write end without sending a termination frame. Under concurrent load this could be a server-side connection pool limit that silently drops the stream body rather than returning an error.\n\n**On the retry path not recovering:** this makes sense if the retry opens a new SSE connection that hits the same pool limit. The fix would need to either: (a) wait for one of the existing connections to close before retrying, or (b) add backoff with jitter to space out the concurrent reconnects.\n\n**A possible mitigation while this is open:** reducing `max_concurrent_agents` to 3 via CLAUDE.md or a PreToolUse hook, then checking if the stall frequency drops proportionally. If 3 concurrent streams are stable and 5 are not, that would point directly at a concurrency limit somewhere in the connection path.\n\nI haven't seen a clean fix for this at the client side - it really needs a server-side investigation into what's happening when 5+ SSE streams are open simultaneously. Thanks for the thorough debug trace; this is the clearest report of this pattern I've seen.\n","bodyHTML":"\u003cp dir=\"auto\"\u003eThis is a very clean reproduction - the debug trace makes it clear this is a connection-pool or stream-multiplexing issue specific to concurrent SSE streams, not a general network problem. The fact that main-thread heartbeats stayed healthy while subagent streams went silent is the key signal.\u003c/p\u003e\n\u003cp dir=\"auto\"\u003eA few observations that might help narrow it down:\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003eThe 60s vs 180s watchdog split is interesting.\u003c/strong\u003e Your trace shows \u003ccode class=\"notranslate\"\u003eidleDeadlineMs=180000\u003c/code\u003e in the WARN lines but the watchdog fires at 60000ms. That suggests there are two separate timers - one for the stream itself and one specifically for the \u003ccode class=\"notranslate\"\u003eAsyncAgent\u003c/code\u003e wrapper - and the agent-level one is the tighter gate. Worth checking if increasing the agent watchdog timeout (if configurable) changes behavior, or if the streams are genuinely dying at the server side.\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003eThe \"exactly one chunk then silence\" pattern\u003c/strong\u003e (647 bytes after 1.1s, then nothing for 60s) is distinct from slow streams. It looks like the connection is accepted and headers/initial data arrive, then the upstream closes or drops the write end without sending a termination frame. Under concurrent load this could be a server-side connection pool limit that silently drops the stream body rather than returning an error.\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003eOn the retry path not recovering:\u003c/strong\u003e this makes sense if the retry opens a new SSE connection that hits the same pool limit. The fix would need to either: (a) wait for one of the existing connections to close before retrying, or (b) add backoff with jitter to space out the concurrent reconnects.\u003c/p\u003e\n\u003cp dir=\"auto\"\u003e\u003cstrong\u003eA possible mitigation while this is open:\u003c/strong\u003e reducing \u003ccode class=\"notranslate\"\u003emax_concurrent_agents\u003c/code\u003e to 3 via CLAUDE.md or a PreToolUse hook, then checking if the stall frequency drops proportionally. If 3 concurrent streams are stable and 5 are not, that would point directly at a concurrency limit somewhere in the connection path.\u003c/p\u003e\n\u003cp dir=\"auto\"\u003eI haven't seen a clean fix for this at the client side - it really needs a server-side investigation into what's happening when 5+ SSE streams are open simultaneously. Thanks for the thorough debug trace; this is the clearest report of this pattern I've seen.\u003c/p\u003e","bodyVersion":"93e8a671c0fbf981523ac54d77c76765572abf9ba630374f9f35e0956a34ec03","isHidden":false,"viewerCanUpdate":false,"repository":{"id":"R_kgDON91aYw","name":"claude-code","owner":{"__typename":"Organization","id":"MDEyOk9yZ2FuaXphdGlvbjc2MjYzMDI4","login":"anthropics","url":"https://github.com/anthropics"},"isPrivate":false,"viewerCanCreateIssues":false,"slashCommandsEnabled":false,"nameWithOwner":"anthropics/claude-code","databaseId":937253475},"reactionGroups":[{"content":"THUMBS_UP","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"THUMBS_DOWN","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"LAUGH","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"HOORAY","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"CONFUSED","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"HEART","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"ROCKET","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}},{"content":"EYES","viewerHasReacted":false,"reactors":{"totalCount":0,"nodes":[]}}],"__isNode":"IssueComment"},"cursor":"Y3Vyc29yOnYyOpPPAAABoAIEjcAAqjUyOTc5OTU3MTE="},{"node":{"__typename":"LabeledEvent","__isTimelineEvent":"LabeledEvent","databaseId":30206584393,"createdAt":"2026-08-29T10:09:04Z","actor":{"id":"MDM6Qm90NDE4OTgyODI=","avatarUrl":"https://avatars.githubusercontent.com/in/15368?s=64\u0026v=4","login":"github-actions","profileResourcePath":"/apps/github-actions","__typename":"Bot","isCopilot":false,"isAgent":false,"displayName":"github-actions[bot]"},"lab