\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}The statistic}{2}{subsection.3.1}\protected@file@percent }
\citation{confidentwrong2026}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}Replacing the target with ground truth}{3}{subsection.3.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces The same edit steps under two target definitions, \emph  {pooled over runs} (\texttt  {\small  wrongness.json}). The conventional statistic and the independent one disagree in \emph  {sign}. Within-instance paired means for the gold target are $0.496$ solved vs $0.448$ failed ($p=0.007$, $228$ instances).}}{3}{table.caption.8}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}A control that both metrics are sane}{3}{subsection.3.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4}The robust measure, and why the shares are not}{3}{subsection.3.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces The binary measure is positive in \emph  {every} stratum. The share-based gold measure is $+0.070$ pooled but only $+0.020$ after standardising over patch width --- $72\%$ of the gap is composition --- and flips sign inside strata 2--4. We therefore quote the binary measure and refuse to quote the share.}}{3}{table.caption.9}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.5}Three mechanisms tested; all three falsified}{3}{subsection.3.5}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.6}Two independent replications on eight unseen shards}{4}{subsection.3.6}\protected@file@percent }
\newlabel{sec:repl}{{3.6}{4}{Two independent replications on eight unseen shards}{subsection.3.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Three disjoint sets of $\sim $26{,}000 runs each. The broken metric inverts in every one; the gold target reverses it back in every one, with the paired test \emph  {strengthening} on unseen data; and the wrong-fix share varies by only $2.6$ points.}}{4}{table.caption.10}\protected@file@percent }
