\@writefile{toc}{\contentsline {section}{\numberline {4}Results}{3}{section.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}The published detectors cannot make this decision}{3}{subsection.4.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Identical rows, identical task-disjoint folds. Averaged over 24 cells (every ordered pair of the three shard sets $\times $ four prefix fractions). On the mode question the published families carry \emph  {no information}.}}{3}{table.caption.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}It transfers to runs it has never seen}{3}{subsection.4.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Cross-set AUC equals within-set AUC. \textbf  {Gain over the field: +0.156 AUC (failure), +0.136 AUC (mode)} --- at every fraction, in every direction, on data the model never saw.}}{3}{table.caption.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Calibration, done properly}{3}{subsection.4.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Beats all three at every fraction and every cost setting --- 12 of 12 cells.}}{4}{table.caption.6}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}It is worth acting on}{4}{subsection.4.4}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {5}Testing the premise live: the verifier was giving the answer away}{4}{section.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Valid episodes only. 13 of 96 episodes were dropped because the mutated package did not actually fail its suite at episode start, which makes success meaningless; including them gives 0.596 and 0.449, i.e.\ the filter \emph  {lowers} both arms. The hinted--unmasked difference is \textbf  {not significant} (Fisher $p = 0.126$).}}{4}{table.caption.7}\protected@file@percent }
